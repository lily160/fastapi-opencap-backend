DB_URL=mysql+pymysql://root@127.0.0.1:3306/opencap?charset=utf8mb4
DB_ECHO=False

SECRET_KEY=change-me-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=3600
REFRESH_TOKEN_EXPIRE_DAYS=7

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_FORGOT_PASSWORD_TOPIC=forgot-password-code

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your@qq.com
SMTP_PASSWORD=your-qq-mail-app-password

# Alibaba Cloud SMS (Dysmsapi)
SMS_ACCESS_KEY_ID=your-access-key-id
SMS_ACCESS_KEY_SECRET=your-access-key-secret
SMS_SIGN_NAME=your-sms-sign-name
SMS_TEMPLATE_CODE=SMS_100003
SMS_ENDPOINT=dysmsapi.aliyuncs.com
